{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node", "jest"],
    "baseUrl": "./src",
    "paths": {
      "@services/*": ["services/*"],
      "@entities/*": ["entities/*"],
      "@dto/*": ["dto/*"],
      "@config/*": ["config/*"],
      "@main/*": ["main/*"],
      "@app/*": ["app/*"],
      "@utils/*": ["utils/*"],
      "@libs/*": ["libs/*"],
      "@types/*": ["types/*"],
      "@client/*": ["client/*"],
      "@controllers/*": ["controllers/*"],
      "@middlewares/*": ["middlewares/*"],
      "@middleware/*": ["middleware/*"],
      "@guards/*": ["guards/*"],
      "@interceptors/*": ["interceptors/*"],
      "@filters/*": ["filters/*"],
      "@schemas/*": ["schemas/*"],
      "@common/*": ["common/*"],
      "@errors/*": ["errors/*"],
      "@constants/*": ["constants/*"],
      "@enums/*": ["enums/*"],
      "@repositories/*": ["repositories/*"],
    },
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false,
    "noEmit": false,
    "outDir": "./dist",
    "module": "commonjs",
    "allowImportingTsExtensions": false

  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
